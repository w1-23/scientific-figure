{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Scientific Figure Reconstruction Plan 0.3",
  "description": "Semantic mode accepts only host-authored construct steps and a lightweight brief, with optional reference binding. Pixel mode retains Plan 0.2 pixel operations, source-local canvas and final pixel evaluation; brief and semantic complexity limits are not accepted in pixel mode. Resources use Scene 0.1 validation.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "mode", "canvas", "steps"],
  "properties": {
    "schema_version": {"const": "0.3"},
    "mode": {"enum": ["semantic", "pixel"]},
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["sha256", "size", "region"],
      "properties": {
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "size": {"type": "array", "items": {"type": "integer", "minimum": 1}, "minItems": 2, "maxItems": 2},
        "region": {"type": "array", "items": {"type": "integer", "minimum": 0}, "minItems": 4, "maxItems": 4},
        "description": {"type": "string"}
      }
    },
    "canvas": {
      "type": "object", "additionalProperties": false, "required": ["width", "height"],
      "properties": {
        "width": {"type": "number", "exclusiveMinimum": 0, "maximum": 8192},
        "height": {"type": "number", "exclusiveMinimum": 0, "maximum": 8192},
        "background": {"type": "string"},
        "viewBox": {"type": "array", "items": {"type": "number"}, "minItems": 4, "maxItems": 4}
      }
    },
    "resources": {"type": "array", "items": {"type": "object"}},
    "notes": {"type": "array", "items": {"type": "string"}},
    "drawing_policy": {"type": "object"},
    "search_budget": {"type": "object"},
    "adaptive_profile": {"type": "object"},
    "brief": {
      "description": "Intent only. Coordinates, geometry and copies of the Scene are not fields of this brief. target_size is output width/height, equal to canvas dimensions. All protected_ids are required to exist and be mechanically visible.",
      "type": "object", "additionalProperties": false,
      "required": ["purpose", "target_size", "simplification", "protected_ids", "allowed_omissions", "uncertainties"],
      "properties": {
        "purpose": {"type": "string", "minLength": 1, "maxLength": 1000},
        "target_size": {"type": "array", "items": {"type": "number", "exclusiveMinimum": 0, "maximum": 8192}, "minItems": 2, "maxItems": 2},
        "simplification": {"type": "string", "minLength": 1, "maxLength": 1000},
        "protected_ids": {"type": "array", "maxItems": 3000, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_.-]{0,99}$"}},
        "allowed_omissions": {"$ref": "#/$defs/brief_notes"},
        "uncertainties": {"$ref": "#/$defs/brief_notes"}
      }
    },
    "complexity_limits": {
      "description": "All non-group nodes count, including hidden ones. segments counts parsed SVG path line/curve/close operations, including implicit commands and expanded arcs. Defaults are 128 draw_nodes and 2400 segments.",
      "type": "object", "additionalProperties": false,
      "properties": {
        "draw_nodes": {"type": "integer", "minimum": 1, "maximum": 3000, "default": 128},
        "segments": {"type": "integer", "minimum": 1, "maximum": 20000, "default": 2400}
      }
    },
    "steps": {
      "type": "array", "minItems": 1, "maxItems": 3000,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["step_id", "operation", "object"],
        "properties": {
          "step_id": {"type": "string", "minLength": 1},
          "operation": {"enum": ["construct", "trace_region", "fit_stroke", "auto_reconstruct"]},
          "object": {"type": "object"},
          "depends_on": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
          "region": {"type": "array", "items": {"type": "integer", "minimum": 0}, "minItems": 4, "maxItems": 4},
          "parameters": {"type": "object"},
          "policy": {"type": "object"}
        }
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"mode": {"const": "semantic"}}},
      "then": {
        "required": ["brief"],
        "not": {"anyOf": [{"required": ["search_budget"]}, {"required": ["adaptive_profile"]}, {"required": ["drawing_policy"]}]},
        "properties": {"steps": {"items": {
          "properties": {"operation": {"const": "construct"}},
          "not": {"anyOf": [{"required": ["region"]}, {"required": ["parameters"]}, {"required": ["policy"]}]}
        }}}
      },
      "else": {
        "required": ["source"],
        "not": {"anyOf": [{"required": ["brief"]}, {"required": ["complexity_limits"]}]},
        "properties": {"steps": {"maxItems": 100}}
      }
    }
  ],
  "$defs": {
    "brief_notes": {"type": "array", "maxItems": 32, "items": {"type": "string", "minLength": 1, "maxLength": 500}}
  }
}
