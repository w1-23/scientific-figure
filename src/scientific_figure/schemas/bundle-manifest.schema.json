{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Scientific Figure Bundle Manifest 0.1",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "kind", "assets"],
  "properties": {
    "schema_version": {"const": "0.1"},
    "kind": {"const": "scientific-figure-asset-bundle"},
    "assets": {"type": "array", "minItems": 1, "maxItems": 128, "items": {"$ref": "#/$defs/asset"}}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "asset": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "project", "member_receipt_sha256", "id_namespace", "source", "viewBox", "canvas", "font", "runtime", "runtime_sha256"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_.-]{0,99}$"},
        "project": {"type": "string", "pattern": "^assets/[A-Za-z_][A-Za-z0-9_.-]{0,99}$"},
        "member_receipt_sha256": {"$ref": "#/$defs/hash"},
        "id_namespace": {
          "type": "object", "additionalProperties": false, "required": ["objects", "resources"],
          "properties": {
            "objects": {"type": "array", "maxItems": 3000, "uniqueItems": true, "items": {"type": "string"}},
            "resources": {"type": "array", "maxItems": 3000, "uniqueItems": true, "items": {"type": "string"}}
          }
        },
        "source": {"type": ["object", "null"]},
        "viewBox": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "number"}},
        "canvas": {"type": "object"},
        "font": {
          "type": "object", "additionalProperties": false, "required": ["family", "sha256"],
          "properties": {
            "family": {"type": "string", "minLength": 1},
            "sha256": {"$ref": "#/$defs/hash"}
          }
        },
        "runtime": {"type": "object"},
        "runtime_sha256": {"$ref": "#/$defs/hash"}
      }
    }
  }
}
