{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Scientific Figure Bundle Plan 0.1",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "assets"],
  "properties": {
    "schema_version": {"const": "0.1"},
    "assets": {"type": "array", "minItems": 1, "maxItems": 128, "items": {
      "type": "object", "additionalProperties": false, "required": ["id", "project"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_.-]{0,99}$"},
        "project": {"type": "string", "minLength": 1, "maxLength": 1024}
      }
    }}
  }
}
