{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "Constraint pack 0.1",
 "type": "object", "additionalProperties": false,
 "required": ["schema_version", "kind", "created_at", "source", "parameters", "scales",
              "mappings", "bindings", "edge_packs", "regions", "holes", "repetitions",
              "palette", "artifacts", "pack_sha256", "versions", "limits"],
 "properties": {
  "schema_version": {"const": "0.1"},
  "kind": {"const": "constraint_pack"},
  "created_at": {"type": "string", "minLength": 1, "maxLength": 64},
  "source": {"type": "object", "additionalProperties": true,
             "required": ["path", "sha256", "size", "roi"],
             "properties": {"path": {"type": "string", "minLength": 1},
                            "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
                            "size": {"type": "array", "items": {"type": "integer"}, "minItems": 2, "maxItems": 2},
                            "roi": {"$ref": "#/$defs/region"}}},
  "parameters": {"type": "object"},
  "scales": {"type": "array", "minItems": 1, "maxItems": 3, "uniqueItems": true,
             "items": {"enum": ["coarse", "medium", "fine"]}},
  "mappings": {"type": "object", "additionalProperties": false,
               "required": ["source_to_roi", "roi_to_source"],
               "properties": {"source_to_roi": {"$ref": "#/$defs/matrix"},
                              "roi_to_source": {"$ref": "#/$defs/matrix"}}},
  "bindings": {"type": "array", "maxItems": 500, "items": {"$ref": "#/$defs/binding"}},
  "edge_packs": {"type": "object", "minProperties": 1, "maxProperties": 3,
                 "additionalProperties": {"type": "object", "additionalProperties": false,
                   "required": ["artifact", "components", "contours", "truncated"],
                   "properties": {"artifact": {"type": "string", "minLength": 1},
                                  "components": {"type": "array", "maxItems": 4000},
                                  "contours": {"type": "array", "maxItems": 2000},
                                  "truncated": {"type": "boolean"}}}},
  "regions": {"type": "array", "maxItems": 400, "items": {"type": "object"}},
  "holes": {"type": "array", "maxItems": 400, "items": {"type": "object"}},
  "repetitions": {"type": "array", "maxItems": 200, "items": {"type": "object"}},
  "palette": {"type": "array", "maxItems": 8, "items": {"type": "object", "additionalProperties": false,
              "required": ["hex", "pixels"],
              "properties": {"hex": {"type": "string", "pattern": "^#[a-f0-9]{6}$"},
                             "pixels": {"type": "integer", "minimum": 0}}}},
  "artifacts": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"type": "object",
                "additionalProperties": false, "required": ["path", "sha256", "bytes"],
                "properties": {"path": {"type": "string", "minLength": 1},
                               "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
                               "bytes": {"type": "integer", "minimum": 1}}}},
  "pack_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
  "versions": {"type": "object"},
  "limits": {"type": "object"}
 },
 "$defs": {
  "matrix": {"type": "array", "items": {"type": "number"}, "minItems": 6, "maxItems": 6},
  "region": {"type": "array", "items": {"type": "integer"}, "minItems": 4, "maxItems": 4},
  "binding": {"type": "object", "additionalProperties": false,
              "required": ["object_id", "kind", "source_region", "allowed_deviation",
                           "recall_min", "group", "min_count", "notes"],
              "properties": {"object_id": {"type": "string", "minLength": 1, "maxLength": 100},
                             "kind": {"enum": ["boundary", "region", "negative_space", "repetition"]},
                             "source_region": {"oneOf": [{"$ref": "#/$defs/region"}, {"type": "null"}]},
                             "allowed_deviation": {"type": "number", "exclusiveMinimum": 0, "maximum": 40},
                             "recall_min": {"type": "number", "minimum": 0, "maximum": 1},
                             "group": {"type": ["string", "null"], "maxLength": 100},
                             "min_count": {"type": "integer", "minimum": 1, "maximum": 1000},
                             "notes": {"type": "string", "maxLength": 2000}}}
 }
}
