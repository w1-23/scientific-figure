{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Scientific Figure Layout Manifest 0.1",
  "type": "object", "additionalProperties": false, "required": ["schema_version", "id", "entries"],
  "properties": {
    "schema_version": {"const": "0.1"}, "id": {"$ref": "#/$defs/id"},
    "entries": {"type": "array", "maxItems": 3000, "items": {
      "type": "object", "additionalProperties": false, "required": ["id", "object_ids", "relation"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "object_ids": {"type": "array", "minItems": 2, "maxItems": 3000, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "relation": {"enum": ["aligned_left", "aligned_top", "same_width", "same_height", "contains", "left_of", "above"]},
        "tolerance": {"type": "number", "minimum": 0, "maximum": 10000000},
        "uncertainty_ids": {"$ref": "#/$defs/ids"}, "evidence_ids": {"$ref": "#/$defs/ids"}
      }
    }}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_.-]{0,99}$"},
    "ids": {"type": "array", "maxItems": 3000, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}
  }
}
