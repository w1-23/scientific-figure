{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Adaptive Reconstruction Plan 0.2",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "source", "canvas", "steps"],
  "properties": {
    "schema_version": {"const": "0.2"},
    "source": {"type": "object", "additionalProperties": false, "required": ["sha256", "size", "region"], "properties": {
      "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
      "size": {"type": "array", "items": {"type": "integer", "minimum": 1}, "minItems": 2, "maxItems": 2},
      "region": {"type": "array", "items": {"type": "integer", "minimum": 0}, "minItems": 4, "maxItems": 4},
      "description": {"type": "string"}
    }},
    "canvas": {"type": "object"}, "resources": {"type": "array", "items": {"type": "object"}},
    "notes": {"type": "array", "items": {"type": "string"}}, "drawing_policy": {"type": "object"},
    "search_budget": {"type": "object"}, "adaptive_profile": {"type": "object"},
    "steps": {"type": "array", "minItems": 1, "maxItems": 100, "items": {
      "type": "object", "additionalProperties": false, "required": ["step_id", "operation", "object"],
      "properties": {
        "step_id": {"type": "string"},
        "operation": {"enum": ["construct", "trace_region", "fit_stroke", "auto_reconstruct"]},
        "object": {"type": "object"},
        "region": {"type": "array", "items": {"type": "integer", "minimum": 0}, "minItems": 4, "maxItems": 4},
        "parameters": {"type": "object"}, "policy": {"type": "object"},
        "depends_on": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    }}
  }
}
