{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Scientific Figure Style Profile 0.1",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "id", "tokens"],
  "properties": {
    "schema_version": {"const": "0.1"},
    "id": {"$ref": "#/$defs/id"},
    "tokens": {"type": "array", "maxItems": 1000, "items": {"$ref": "#/$defs/token"}},
    "line_cap": {"const": "round"},
    "line_join": {"const": "round"},
    "corners": {
      "type": "object", "additionalProperties": false, "required": ["kind", "radius"],
      "properties": {"kind": {"const": "round"}, "radius": {"type": "number", "exclusiveMinimum": 0, "maximum": 10000000}}
    },
    "font": {
      "type": "object", "additionalProperties": false, "required": ["family", "scripts"],
      "properties": {
        "family": {"type": "string", "minLength": 1, "maxLength": 200},
        "scripts": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["latin", "cjk"]}}
      }
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_.-]{0,99}$"},
    "color": {"type": "string", "pattern": "^(#[0-9a-fA-F]{3}|#[0-9a-fA-F]{6}|#[0-9a-fA-F]{8}|none)$"},
    "point": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number", "minimum": -10000000, "maximum": 10000000}},
    "gradient": {
      "type": "object", "additionalProperties": false, "required": ["kind", "start", "end", "stops"],
      "properties": {
        "kind": {"const": "linear_gradient"}, "start": {"$ref": "#/$defs/point"}, "end": {"$ref": "#/$defs/point"},
        "stops": {"type": "array", "minItems": 2, "maxItems": 256, "items": {
          "type": "array", "minItems": 2, "maxItems": 2,
          "prefixItems": [{"type": "number", "minimum": 0, "maximum": 1}, {"$ref": "#/$defs/color"}], "items": false
        }}
      }
    },
    "token": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["id", "type", "value"], "properties": {
          "id": {"$ref": "#/$defs/id"}, "type": {"const": "color"}, "value": {"$ref": "#/$defs/color"}}},
        {"type": "object", "additionalProperties": false, "required": ["id", "type", "value"], "properties": {
          "id": {"$ref": "#/$defs/id"}, "type": {"const": "number"}, "value": {"type": "number", "minimum": 0, "maximum": 10000000}}},
        {"type": "object", "additionalProperties": false, "required": ["id", "type", "value"], "properties": {
          "id": {"$ref": "#/$defs/id"}, "type": {"const": "font"}, "value": {"type": "string", "minLength": 1, "maxLength": 200}}},
        {"type": "object", "additionalProperties": false, "required": ["id", "type", "value"], "properties": {
          "id": {"$ref": "#/$defs/id"}, "type": {"const": "linear_gradient"}, "value": {"$ref": "#/$defs/gradient"}}}
      ]
    }
  }
}
